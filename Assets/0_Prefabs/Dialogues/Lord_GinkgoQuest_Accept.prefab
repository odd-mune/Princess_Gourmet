  m_Script: {fileID: 11500000, guid: cb0185f521b5dfe4ba7f5180db417f8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Id: 2001
  DialogueOnInteraction:
  - talkerSprite: {fileID: 227537382, guid: 9ee43c0dddb78954a953076721d10a2c, type: 3}
    princessSprite: {fileID: 28235472, guid: 0a12d33068d857843b36345c347d16d8, type: 3}
    isPrincessSpeaking: 0
    dialogue: "\uC800\uD76C \uC544\uBB88\uC988 \uB9C8\uC744 \uC8FC\uBBFC\uB4E4\uC740
      \uB18D\uC0AC\uB97C \uC5C5\uC73C\uB85C \uC0BC\uACE0 \uC788\uB2F5\uB2C8\uB2E4"
  - talkerSprite: {fileID: 1494300898, guid: 9ee43c0dddb78954a953076721d10a2c, type: 3}
    princessSprite: {fileID: -700349343, guid: 34e75958dd4a94347b79201cdbc6403d, type: 3}
    isPrincessSpeaking: 0
    dialogue: "\uD2B9\uD788 \uC544\uBB88\uC988 \uB9C8\uC744\uC5D0\uC11C \uB098\uB294
      \uBCBC\uB294 \uC54C\uC544\uC8FC\uB294 \uC0C1\uD488\uC774\uC8E0"
  - talkerSprite: {fileID: 1494300898, guid: 9ee43c0dddb78954a953076721d10a2c, type: 3}
    princessSprite: {fileID: -700349343, guid: 34e75958dd4a94347b79201cdbc6403d, type: 3}
    isPrincessSpeaking: 0
    dialogue: "\uADF8\uB7F0\uB370 \uC694\uC998 \uC740\uD589 \uBA67\uB3FC\uC9C0\uAC00
      \uADFC\uCC98\uC5D0\uC11C \uC5EC\uB7FF \uCD9C\uBAB0\uD574\uC11C \uB18D\uC0AC\uB97C
      \uB9DD\uCE58\uACE0 \uC788\uC5B4\uC694"
  - talkerSprite: {fileID: 1494300898, guid: 9ee43c0dddb78954a953076721d10a2c, type: 3}
    princessSprite: {fileID: -700349343, guid: 34e75958dd4a94347b79201cdbc6403d, type: 3}
    isPrincessSpeaking: 0
    dialogue: "\uC800\uD76C \uB9C8\uC744 \uC8FC\uBBFC\uC73C\uB85C\uC11C\uB294 \uB9C8\uBB3C\uC744
      \uB9C9\uAE30\uC5D4 \uBC85\uCC2C \uC0C1\uD0DC\uC778\uC9C0\uB77C..."
  - talkerSprite: {fileID: 1494300898, guid: 9ee43c0dddb78954a953076721d10a2c, type: 3}
    princessSprite: {fileID: -700349343, guid: 34e75958dd4a94347b79201cdbc6403d, type: 3}
    isPrincessSpeaking: 0
    dialogue: "\uACF5\uC8FC\uB2D8!! \uC81C\uBC1C \uC800\uD76C \uB9C8\uC744\uC744
      \uC740\uD589 \uBA67\uB3FC\uC9C0\uB85C\uBD80\uD130 \uAD6C\uD574\uC8FC\uC138\uC694!!"
  - talkerSprite: {fileID: 1494300898, guid: 9ee43c0dddb78954a953076721d10a2c, type: 3}
    princessSprite: {fileID: -700349343, guid: 34e75958dd4a94347b79201cdbc6403d, type: 3}
    isPrincessSpeaking: 0
    dialogue: "\uADFC\uBC29\uC5D0 \uCD9C\uBAB0\uD558\uB294 \uC740\uD589 \uBA67\uB3FC\uC9C0
      \uB2E4\uC12F \uB9C8\uB9AC\uB97C \uD1A0\uBC8C\uD574\uC8FC\uC138\uC694!!"
  OnDialogueEndEvent:
    m_PersistentCalls:
      m_Calls: []
