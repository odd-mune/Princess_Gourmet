MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 998122452513106037}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb0185f521b5dfe4ba7f5180db417f8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Id: -1
  DialogueOnInteraction:
  - talkerSprite: {fileID: 0}
    princessSprite: {fileID: 0}
    isPrincessSpeaking: 0
    dialogue: "\uC608\uB85C\uBD80\uD130 \uC774 \uC138\uC0C1\uC740 \uC694\uB9AC\uC758
      \uC2E0 \uAD6C\uD750\uBA54\uC758 \uC740\uCD1D\uC73C\uB85C \uD0C4\uC0DD\uD588\uB2E4"
  - talkerSprite: {fileID: 0}
    princessSprite: {fileID: 0}
    isPrincessSpeaking: 0
    dialogue: "\uADF8 \uC911 \uC544\uBB88\uC988 \uC5EC\uC2E0\uC758 \uBE75\uC758 \uC740\uCD1D\uC740
      \uC774 \uC138\uC0C1\uC758 \uADFC\uAC04\uC774 \uB418\uC5C8\uB2E4"
  - talkerSprite: {fileID: 0}
    princessSprite: {fileID: 0}
    isPrincessSpeaking: 0
    dialogue: "\uC774 \uB545\uC740 \uC544\uBB88\uC988 \uC5EC\uC2E0\uC758 \uC190\uAE38\uC774
      \uCC98\uC74C\uC73C\uB85C \uB2FF\uC740 \uACF3..."
  - talkerSprite: {fileID: 0}
    princessSprite: {fileID: 0}
    isPrincessSpeaking: 0
    dialogue: "\uADF8\uB140\uC758 \uC190\uAE38\uC5D0\uC11C \uBCBC\uAC00, \uADF8\uB140\uC758
      \uC785\uC220\uC5D0\uC11C \uC18C\uAC00 \uC774 \uB545\uC5D0 \uC0DD\uACBC\uB2E4"
  - talkerSprite: {fileID: 0}
    princessSprite: {fileID: 0}
    isPrincessSpeaking: 0
    dialogue: "\uADF8 \uC740\uCD1D\uC740 \uBE75\uC774\uB77C\uB294 \uC694\uB9AC\uAC00
      \uB418\uC5B4 \uC778\uAC04\uB4E4\uC744 \uC720\uC775\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4"
  - talkerSprite: {fileID: 0}
    princessSprite: {fileID: 0}
    isPrincessSpeaking: 0
    dialogue: "\uC544\uBB88\uC988 \uC5EC\uC2E0\uC740 \uC774\uB97C \uAE30\uB824 \uC2E0\uC804\uC744
      \uB9CC\uB4E4\uB77C \uBA85\uD558\uC600\uB2E4"
  OnDialogueEndEvent:
    m_PersistentCalls:
      m_Calls: []
